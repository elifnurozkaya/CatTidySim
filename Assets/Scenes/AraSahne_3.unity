--- !u!114 &1265671593
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1265671588}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d48aeab8c11a0a641a23e7d1a813d4ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DinamikDiyalog
  isimText: {fileID: 1827333463}
  mesajText: {fileID: 53261304}
  kediGorseli: {fileID: 1355649525}
  adamGorseli: {fileID: 1172788857}
  diyaloglar:
  - konusanKisi: Adam
    cumle: "\"\u0130nan\u0131lmaz... Salondaki o karma\u015Fay\u0131 bile \xE7\xF6zm\xFC\u015Fs\xFCn. 
      Ger\xE7ekten \xE7ok dikkatli bir kedisin."
  - konusanKisi: Kedi
    cumle: Miyavv~
  - konusanKisi: Adam
    cumle: "Hak etti\u011Fin \xF6d\xFCl mamas\u0131 burada. Enerjini topla \xE7\xFCnk\xFC
      son bir odam\u0131z kald\u0131: Yatak Odas\u0131"
  - konusanKisi: Adam
    cumle: "Ye\u011Fenim en \xE7ok arabay\u0131 oraya saklam\u0131\u015F. Dolaplar\u0131n
      alt\u0131, yata\u011F\u0131n arkas\u0131 her yer renkli arabalarla dolu. Buray\u0131
      da ba\u015Far\u0131yla tamamlarsan, art\u0131k bu evin resmi olarak bir \xFCyesi
      olacaks\u0131n. Sana g\xFCveniyorum"
  - konusanKisi: Kedi
    cumle: "\"Miyav!\" (Son oda kald\u0131, onu da hallediyorum!)"
  sonrakiSahneAdi: Yatak_Odasi_Sahnesi
