  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Kedi, son odadaki karma\u015Fay\u0131 da kusursuz bir \u015Fekilde toparlamay\u0131
    ba\u015Fard\u0131 ve verdi\u011Fi s\xF6z\xFC tutarak ev sahibini kendine hayran
    b\u0131rakt\u0131. Art\u0131k o so\u011Fuk, ya\u011Fmurlu ve tehlikeli sokaklara
    hi\xE7bir zaman d\xF6nmesine gerek kalmam\u0131\u015Ft\u0131. Ev sahibi, en ba\u015Ftaki
    anla\u015Fmalar\u0131na sad\u0131k kalarak ona \u015F\xF6minenin hemen yan\u0131na
    s\u0131cac\u0131k, yumu\u015Fac\u0131k bir minder haz\u0131rlad\u0131 ve \xF6n\xFCne
    en lezzetli mamalarla dolu kocaman bir kase koydu. Yeme\u011Fini afiyetle yedikten
    sonra yeni yata\u011F\u0131na k\u0131vr\u0131lan k\xFC\xE7\xFCk dostumuzun i\xE7ini
    tarifsiz bir huzur kaplad\u0131. G\xFCr\xFClt\xFCl\xFC arabalar, \u0131slak kald\u0131r\u0131mlar
    ve \xE7\xF6plerin aras\u0131ndaki o zorlu g\xFCnler art\u0131k sadece uzak birer
    an\u0131dan ibaretti. Kedi, g\xFCvende olman\u0131n verdi\u011Fi o muhte\u015Fem
    hisle hafif\xE7e m\u0131r\u0131ldanarak g\xF6zlerini kapatt\u0131; \xE7\xFCnk\xFC
    sonunda hak etti\u011Fi o sevgi dolu, ger\xE7ek yuvaya kavu\u015Fmu\u015Ftu."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
