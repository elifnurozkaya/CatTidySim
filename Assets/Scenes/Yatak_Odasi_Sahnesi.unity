  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Kedi oday\u0131 zaman\u0131nda toplayamad\u0131\u011F\u0131 i\xE7in ev
    sahibi eve d\xF6nd\xFC ve da\u011F\u0131n\u0131kl\u0131\u011F\u0131 g\xF6r\xFCp
    onu d\u0131\u015Far\u0131 \xE7\u0131kard\u0131. Kendisine sunulan bu muazzam
    f\u0131rsat parmaklar\u0131n\u0131n aras\u0131ndan ak\u0131p gitmi\u015Fti. Sokak
    lambas\u0131n\u0131n soluk \u0131\u015F\u0131\u011F\u0131 alt\u0131nda, \u0131slak
    t\xFCylerini yalayarak teselli bulmaya \xE7al\u0131\u015Ft\u0131. Karn\u0131ndan
    gelen a\xE7l\u0131k sesleri, \xE7\xF6plerin aras\u0131ndaki tehlikeli d\xFCnyay\u0131
    ona yeniden hat\u0131rlatt\u0131. Arabalar\u0131n g\xFCr\xFClt\xFCs\xFC ve korna
    sesleri aras\u0131nda g\xFCvenli bir s\u0131\u011F\u0131nak bulmak art\u0131k
    \xE7ok daha zordu. Ad\u0131mlar\u0131 a\u011F\u0131rla\u015F\u0131rken, s\u0131cak
    bir \u015F\xF6minenin ba\u015F\u0131nda uyuma hayali tamamen suya d\xFC\u015Fm\xFC\u015Ft\xFC.
    Hak etti\u011Fi o huzurlu hayata veda ederek sokaklar\u0131n belirsizli\u011Fine
    do\u011Fru yava\u015F\xE7a g\xF6zden kayboldu."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
