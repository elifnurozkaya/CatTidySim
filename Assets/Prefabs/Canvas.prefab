  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Kedi oday\u0131 yeterince iyi toplayamad\u0131 ve e\u015Fyalar\u0131 yanl\u0131\u015F
    yerlere atarak ev sahibinin g\xFCvenini kazanamad\u0131. Maalesef s\u0131cak
    bir yuva hayali bu darmada\u011F\u0131n odan\u0131n ard\u0131nda kald\u0131.
    Ya\u011Fmur d\u0131\u015Far\u0131da \u015Fiddetini art\u0131r\u0131rken, k\xFC\xE7\xFCk
    dostumuz arkas\u0131na bakarak yava\u015F\xE7a kap\u0131dan uzakla\u015Ft\u0131.
    Sokaklar\u0131n ac\u0131mas\u0131z so\u011Fu\u011Fu ve \u0131slak kald\u0131r\u0131mlar
    onu yeniden kar\u015F\u0131lad\u0131. \xC7\xF6p kutular\u0131n\u0131n kenar\u0131nda
    kendine s\u0131\u011F\u0131nacak kuru bir k\xF6\u015Fe aramaya ba\u015Flad\u0131.
    Gece boyunca titreyerek bir sonraki sabah\u0131n getirece\u011Fi bilinmezli\u011Fi
    bekledi. Hak etti\u011Fi o huzurlu ve sevgi dolu yuvaya kavu\u015Fmak i\xE7in
    ba\u015Fka bir \u015Fans\u0131 olmas\u0131n\u0131 umut ediyordu."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
